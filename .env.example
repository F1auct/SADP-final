DATABASE_URL=jdbc:postgresql://localhost:5432/checkcollect
DATABASE_USER=checkcollect
DATABASE_PASSWORD=replace-with-local-database-password
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-initial-password
APP_SEED_DEMO=true
DEMO_PASSWORD=replace-with-a-unique-demo-password
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false

# M4 消息与交流
# rabbit：使用 RabbitMQ（docker compose --profile messaging up -d rabbitmq）；in-process：无中间件时直接投递。
MESSAGING_TRANSPORT=rabbit
# 开发消息桩：模拟 B/C 调用、故障注入与重复投递验证。生产环境必须改为 false。
MESSAGING_STUB_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
